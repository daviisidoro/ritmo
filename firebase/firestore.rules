rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function household(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId));
    }

    function householdAfter(householdId) {
      return getAfter(/databases/$(database)/documents/households/$(householdId));
    }

    function member(householdId) {
      return signedIn()
        && household(householdId).data.members[request.auth.uid] == true;
    }

    function memberAfter(householdId) {
      return signedIn()
        && householdAfter(householdId).data.members[request.auth.uid] == true;
    }

    function validProfileId(profileId) {
      return profileId in ['d', 'g'];
    }

    function validProfileDocument(profileId) {
      return validProfileId(profileId)
        && request.resource.data.keys().hasAll(['payload', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
        && request.resource.data.payload is map
        && request.resource.data.payload.keys().hasAll(['metrics', 'sessions'])
        && request.resource.data.payload.keys().hasOnly(['metrics', 'sessions', 'theme', 'custom'])
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['householdId', 'profileId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['householdId', 'profileId', 'createdAt'])
        && request.resource.data.householdId is string
        && validProfileId(request.resource.data.profileId)
        && request.resource.data.createdAt == request.time
        && memberAfter(request.resource.data.householdId)
        && householdAfter(request.resource.data.householdId).data.profiles[request.resource.data.profileId] == uid;
      allow update, delete: if false;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{10}$');
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{10}$')
        && request.resource.data.keys().hasAll(['householdId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['householdId', 'createdAt'])
        && request.resource.data.householdId is string
        && request.resource.data.createdAt == request.time
        && memberAfter(request.resource.data.householdId);
      allow update, delete: if false;
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['members', 'profiles', 'inviteCode', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['members', 'profiles', 'inviteCode', 'createdAt', 'updatedAt'])
        && request.resource.data.members is map
        && request.resource.data.members.size() == 1
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true
        && request.resource.data.profiles is map
        && request.resource.data.profiles.size() == 1
        && request.resource.data.profiles.keys().hasOnly(['d', 'g'])
        && request.resource.data.profiles.values().hasOnly([request.auth.uid])
        && request.resource.data.inviteCode.matches('^[A-HJ-NP-Z2-9]{10}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow get: if member(householdId);
      allow list: if false;

      allow update: if signedIn()
        && resource.data.members.size() == 1
        && request.resource.data.members.size() == 2
        && request.resource.data.members.diff(resource.data.members).addedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members.diff(resource.data.members).addedKeys().size() == 1
        && request.resource.data.members.diff(resource.data.members).removedKeys().size() == 0
        && request.resource.data.members.diff(resource.data.members).changedKeys().size() == 0
        && request.resource.data.members[request.auth.uid] == true
        && request.resource.data.profiles.keys().hasOnly(['d', 'g'])
        && request.resource.data.profiles.size() == resource.data.profiles.size() + 1
        && request.resource.data.profiles.diff(resource.data.profiles).addedKeys().size() == 1
        && request.resource.data.profiles.diff(resource.data.profiles).removedKeys().size() == 0
        && request.resource.data.profiles.diff(resource.data.profiles).changedKeys().size() == 0
        && request.resource.data.profiles.values().hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'profiles', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/inviteCodes/$(resource.data.inviteCode)).data.householdId == householdId;

      allow delete: if false;

      match /profiles/{profileId} {
        allow read: if member(householdId) && validProfileId(profileId);
        allow create: if memberAfter(householdId) && validProfileDocument(profileId);
        allow update: if member(householdId) && validProfileDocument(profileId);
        allow delete: if false;
      }
    }
  }
}
